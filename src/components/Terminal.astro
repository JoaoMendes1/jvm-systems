---
// Bloco de código com barra de terminal. O código chega pelo MDX, numa cerca
// ```go dentro do componente, e é copiado do arquivo real do projeto
// (docs/CONTEUDO.md, armadilha "Trecho de código publicado").
interface Props {
  arquivo: string;
}

const { arquivo } = Astro.props;
---
<figure class="term">
  <figcaption class="barra">
    <span class="pontos" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>{arquivo}</span>
  </figcaption>
  <slot />
</figure>

<style>
  /* #08080C é a cor decorativa do terminal, documentada no DESIGN_TOKENS. */
  .term { margin: 0 0 22px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #08080C; box-shadow: 0 20px 50px rgba(0, 0, 0, .4); }
  .barra { display: flex; align-items: center; gap: 9px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: rgba(255, 255, 255, .015); font-family: var(--mono); font-size: 11px; color: var(--fg3); }
  .pontos { display: flex; gap: 7px; }
  .pontos i { width: 10px; height: 10px; border-radius: 50%; background: var(--line2); display: block; }

  /* O realce de sintaxe (Shiki) grava a cor de fundo direto no <pre>, como
     estilo inline. Só o !important vence estilo inline; aqui ele é intencional. */
  .term :global(pre) { margin: 0; padding: 20px 22px; overflow-x: auto; font-size: 12.5px; line-height: 1.8; tab-size: 4; background-color: transparent !important; }
</style>