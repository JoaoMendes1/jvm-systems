---
// Sobre: história, experiência, formação e estudo. Datas e cargos iguais aos
// do LinkedIn (conferido em 03/10/2026). Mudar só com o fato na mão.
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';

const EXPERIENCIA = [
  {
    periodo: 'dez 2025 — hoje',
    cargo: 'Analista de suporte júnior',
    empresa: 'BRD Soluções (cliente Detran SC)',
    descricao: 'Gestão de acesso em sistemas estaduais (DetranNet, Portal ECV e SGPe): análise e concessão de permissões, desbloqueios e redefinição de senhas.',
  },
  {
    periodo: 'jun 2023 — nov 2025',
    cargo: 'Analista de suporte de TI I',
    empresa: 'Stefanini (cliente Oncoclínicas)',
    descricao: 'Suporte N1 e N2 a sistemas e acessos: Office 365, ERP Fluig, Active Directory, MFA e VPN, sob SLA.',
  },
  {
    periodo: 'set 2019 — jul 2021',
    cargo: 'Estagiário de TI',
    empresa: 'Polícia Federal',
    descricao: 'Active Directory, GPOs e File Server, com autonomia para gerenciar permissões; VPN e controle de acesso físico.',
  },
];

const FORMACAO = [
  { periodo: '2017 — 2021', titulo: 'Bacharel em Sistemas de Informação', onde: 'UniNorte (Centro Universitário do Norte)' },
];

const ESTUDANDO = [
  { titulo: 'Formação Full-Stack', onde: 'Rocketseat', detalhe: 'JavaScript, TypeScript, Node.js e React' },
  { titulo: 'Formação Go', onde: 'Rocketseat', detalhe: 'aprofundando o que já uso nos projetos' },
  { titulo: 'IA aplicada', onde: 'nos meus projetos', detalhe: 'RAG e embeddings, começando pelo AniDeck' },
];
---
<Base
  title="Sobre — João Victor Mendes"
  description="Quem eu sou, de onde vim e o que estou construindo e estudando."
>
  <p class="eyebrow">quem escreve isso</p>
  <h1 class="titulo">João Victor<br /><span class="ital grad">Mendes</span></h1>
  <div class="prosa abertura">
    <p>
      Me formei em Sistemas de Informação no Acre, em 2021, e desde a faculdade quis trabalhar com
      desenvolvimento. Vim sozinho para Santa Catarina atrás dessa oportunidade, sem conhecer ninguém
      e sem emprego. Aceitei a primeira vaga que apareceu, no suporte, e foi com ela que me firmei na
      cidade.
    </p>
    <p>
      Hoje sou analista de gestão de acesso, mas o meu objetivo nunca mudou: desenvolvimento. Como as
      empresas pedem experiência comprovada, construo projetos reais e coloco no ar. É o que este site
      reúne.
    </p>
  </div>

  <section class="bloco">
    <h2>Do suporte para o código</h2>
    <p class="prosa">
      No trabalho, cuido de gestão de acesso: quem pode fazer o quê, em qual sistema. Nos meus
      projetos é o mesmo problema, resolvido com JWT e com regras de acesso no próprio banco.
    </p>
  </section>

  <section class="bloco">
    <h2>Experiência</h2>
    <table class="tabela">
      <tbody>
        {EXPERIENCIA.map((t) => (
          <tr>
            <th scope="row">{t.periodo}</th>
            <td><b>{t.cargo}</b> · {t.empresa}<br />{t.descricao}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="bloco">
    <h2>Formação</h2>
    <table class="tabela">
      <tbody>
        {FORMACAO.map((f) => (
          <tr>
            <th scope="row">{f.periodo}</th>
            <td><b>{f.titulo}</b> · {f.onde}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="bloco">
    <h2>Estudando agora</h2>
    <table class="tabela">
      <tbody>
        {ESTUDANDO.map((e) => (
          <tr>
            <th scope="row">{e.onde}</th>
            <td><b>{e.titulo}</b> · {e.detalhe}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <Contato />
</Base>

<style>
  .titulo { font-size: clamp(36px, 6.4vw, 58px); }
  .abertura { margin-top: 26px; }
  .bloco { padding-top: 56px; }
  .prosa { max-width: 64ch; color: var(--fg2); font-size: 16.5px; line-height: 1.75; }
  .prosa p { margin: 0 0 16px; }

  .tabela { width: 100%; border-collapse: collapse; font-size: 14.5px; margin-top: 12px; }
  .tabela th, .tabela td { text-align: left; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tabela th { width: 26%; font-family: var(--mono); font-size: 10.5px; color: var(--fg3); letter-spacing: .07em; font-weight: 400; }
  .tabela td { color: var(--fg2); line-height: 1.6; }
  .tabela b { color: var(--fg); font-weight: 500; }

  /* No celular, rótulo em cima e texto embaixo, em vez de duas colunas apertadas. */
  @media (max-width: 620px) {
    .tabela tr { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .tabela th, .tabela td { display: block; width: auto; padding: 0; border: 0; }
    .tabela th { margin-bottom: 6px; }
  }
</style>