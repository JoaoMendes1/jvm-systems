---
// Página para endereço inexistente. O Astro gera o 404.html, e o Caddy do
// container devolve esse arquivo com o status 404 (ver docker/Caddyfile).
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada — João Victor Mendes" noindex>
  <p class="eyebrow">erro 404</p>
  <h1 class="titulo">Essa página<br /><span class="ital grad">não existe.</span></h1>
  <p class="lede abertura">O endereço pode ter sido digitado errado, ou a página mudou de lugar.</p>
  <div class="actions">
    <a class="btn p" href="/">Ir para a vitrine</a>
    <a class="btn s" href="/sobre">Sobre mim</a>
  </div>
</Base>

<style>
  .titulo { font-size: clamp(44px, 8.4vw, 92px); }
  .abertura { margin-top: 28px; }
  .actions { margin-top: 34px; }
</style>