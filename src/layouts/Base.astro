---
// Layout de todas as páginas: head comum, metadados de compartilhamento,
// fontes e estilo global. Cada página passa o próprio título e, quando
// tiver, a descrição.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  // 'article' para pílula e estudo de caso; o resto do site é 'website'.
  type?: 'website' | 'article';
  // A 404 não deve aparecer em buscador.
  noindex?: boolean;
}

const { title, description, type = 'website', noindex = false } = Astro.props;

// Descrição usada quando a página não passa a sua: a mesma da home.
const descricao = description ?? 'Projetos que construí e mantenho no ar, com o código aberto no GitHub.';

// URL canônica sempre com barra final, o formato que o build gera e que o
// sitemap lista: "/sobre" e "/sobre/" contam como uma página só.
const caminho = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonica = new URL(caminho, Astro.site).href;

// Imagem única de compartilhamento, em public/og.png. Precisa de URL absoluta.
const imagem = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph: o card que aparece ao colar o link no LinkedIn ou WhatsApp. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="João Victor Mendes" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="João Victor Mendes — Construo software e coloco no ar." />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload só nas fontes visíveis logo ao abrir: título e corpo. -->
    <Font cssVariable="--disp" preload />
    <Font cssVariable="--body" preload />
    <Font cssVariable="--edit" />
    <Font cssVariable="--mono" />
  </head>
  <body>
    <!-- Atmosfera: decoração fixa atrás do conteúdo, escondida do leitor de tela. -->
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="vig" aria-hidden="true"></div>
    <Nav />
    <main class="wrap">
      <slot />
    </main>
    <footer class="rodape">
      João Victor Mendes ·
      <a href="https://github.com/JoaoMendes1/jvm-systems" target="_blank" rel="noopener noreferrer">código deste site</a> ·
      <a href="/privacidade">privacidade</a>
    </footer>
  </body>
</html>

<style>
  /* Largura máxima e margem do conteúdo de todas as páginas. O topo maior
     deixa espaço para a barra de navegação fixa. */
  .wrap { position: relative; z-index: 1; max-width: 1080px; margin: 0 auto; padding: 136px 24px 40px; }
  @media (max-width: 620px) { .wrap { padding: 104px 16px 32px; } }

  /* Manchas de cor desfocadas no fundo. Decoração, sem informação. */
  .aurora { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .aurora i { position: absolute; display: block; border-radius: 50%; filter: blur(120px); }
  .aurora i:nth-child(1) { width: 680px; height: 680px; top: -300px; left: -180px; background: color-mix(in srgb, var(--acc) 14%, transparent); }
  .aurora i:nth-child(2) { width: 560px; height: 560px; top: 180px; right: -240px; background: color-mix(in srgb, var(--vio) 11%, transparent); }
  .aurora i:nth-child(3) { width: 460px; height: 460px; bottom: -240px; left: 28%; background: color-mix(in srgb, var(--live) 5.5%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .aurora i { animation: drift 24s ease-in-out infinite; }
    .aurora i:nth-child(2) { animation-duration: 31s; animation-delay: -7s; }
    .aurora i:nth-child(3) { animation-duration: 38s; animation-delay: -14s; }
    @keyframes drift { 0%, 100% { transform: translate3d(0, 0, 0) scale(1); } 50% { transform: translate3d(46px, -34px, 0) scale(1.08); } }
  }
  .vig { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(120% 80% at 50% 0%, transparent 40%, rgba(0, 0, 0, .55) 100%); }

  .rodape { position: relative; z-index: 1; padding: 64px 24px 54px; text-align: center; font-family: var(--mono); font-size: 10.5px; color: var(--fg3); letter-spacing: .05em; }
  .rodape a { color: var(--fg2); }
</style>