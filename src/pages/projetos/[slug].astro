---
// Estudo de caso de um projeto. Só ganha página o projeto com estudo de caso
// (temEstudoDeCaso): sem corpo no .mdx, o card dele aponta para o código.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Decisao from '../../components/Decisao.astro';
import Terminal from '../../components/Terminal.astro';
import Callout from '../../components/Callout.astro';
import { temEstudoDeCaso } from '../../lib/conteudo';

export const getStaticPaths = (async () => {
  const projetos = (await getCollection('projetos')).filter(temEstudoDeCaso);
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { projeto } = Astro.props;
const { Content, headings } = await render(projeto);
const { nome, resumo, status, url, repo, stack, papel } = projeto.data;

// Sumário gerado dos títulos ## do MDX: renomear um título já atualiza o sumário.
const sumario = headings.filter((h) => h.depth === 2);

// "https://anideck.joaomendes.dev.br" vira "anideck.joaomendes.dev.br".
const semProtocolo = (u?: string) => (u ? u.replace(/^https:\/\//, '') : '');
---
<Base title={`${nome} — estudo de caso`} description={resumo}>
  <a class="voltar" href="/#projetos">← vitrine</a>

  <header class="cabeca">
    <p class="eyebrow">{status === 'no-ar' ? 'em produção' : 'em construção'}</p>
    <h1 class="titulo">{nome}</h1>
    <p class="lede abertura">{resumo}</p>
    <ul class="fatos">
      {papel && <li>papel · <b>{papel}</b></li>}
      <li>stack · <b>{stack.join(' · ')}</b></li>
      {url && <li>no ar · <a href={url} target="_blank" rel="noopener noreferrer">{semProtocolo(url)}</a></li>}
      {repo && <li>código · <a href={repo} target="_blank" rel="noopener noreferrer">{semProtocolo(repo)}</a></li>}
    </ul>
  </header>

  <div class="caso">
    <div class="prosa">
      <Content components={{ Decisao, Terminal, Callout }} />
    </div>
    {sumario.length > 1 && (
      <nav class="sumario" aria-label="Nesta página">
        {sumario.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}
  </div>
</Base>

<style>
  .voltar { display: inline-block; margin-bottom: 28px; font-family: var(--mono); font-size: 11.5px; color: var(--fg3); text-decoration: none; }
  .voltar:hover { color: var(--acc); }

  .cabeca { border-bottom: 1px solid var(--line); padding-bottom: 36px; }
  .titulo { font-size: clamp(36px, 6.4vw, 62px); }
  .abertura { margin-top: 22px; }
  .fatos { display: flex; flex-wrap: wrap; gap: 9px; list-style: none; margin: 24px 0 0; padding: 0; }
  .fatos li { border: 1px solid var(--line); border-radius: 11px; padding: 9px 14px; font-size: 12.5px; color: var(--fg3); }
  .fatos b { color: var(--fg); font-weight: 500; }
  .fatos a { color: var(--acc); }

  /* Texto à esquerda e sumário fixo à direita. No celular, o sumário some. */
  .caso { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 54px; align-items: start; }
  .sumario { position: sticky; top: 120px; padding-top: 56px; }
  .sumario a { display: block; font-size: 12.5px; color: var(--fg3); text-decoration: none; padding: 7px 0 7px 14px; border-left: 1px solid var(--line); transition: color .2s; }
  .sumario a:hover { color: var(--fg2); }
  @media (max-width: 900px) {
    .caso { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .sumario { display: none; }
  }

  /* O texto vem do MDX, fora deste componente: por isso o :global. */
  .prosa { max-width: 64ch; color: var(--fg2); font-size: 16.5px; line-height: 1.75; }
  .prosa :global(h2) { padding-top: 56px; margin-bottom: 14px; color: var(--fg); }
  .prosa :global(strong) { color: var(--fg); font-weight: 500; }
  .prosa :global(a) { color: var(--acc); }
  .prosa :global(p code) { font-size: .9em; }

  /* Tabela do "O que quebrou": sintoma × causa e correção. */
  .prosa :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; margin: 8px 0 22px; }
  .prosa :global(th), .prosa :global(td) { text-align: left; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prosa :global(th) { font-family: var(--mono); font-size: 10px; color: var(--fg3); letter-spacing: .07em; font-weight: 400; }
  .prosa :global(td:first-child) { width: 34%; }
  @media (max-width: 620px) {
    .prosa :global(thead) { display: none; }
    .prosa :global(tr) { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .prosa :global(td) { display: block; width: auto !important; padding: 0; border: 0; }
    .prosa :global(td + td) { margin-top: 6px; }
  }
</style>