---
// Lista de pílulas, da mais recente para a mais antiga. Contagem e filtros
// saem da coleção, nunca de lista fixa.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { pilulaPublicada, tempoDeLeitura, visivel } from '../../lib/conteudo';
import { formatarData, dataISO } from '../../lib/datas';

const pilulas = (await getCollection('pilulas'))
  .filter(pilulaPublicada)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

// Nome de exibição de cada projeto. Projeto em rascunho fica de fora: a pílula
// aparece normalmente, só sem o nome de um projeto que o site não mostra.
const nomes = new Map(
  (await getCollection('projetos')).filter(visivel).map((p) => [p.id, p.data.nome]),
);
type Projeto = { id: string; nome: string };
const projetoDe = (p: (typeof pilulas)[number]): Projeto | undefined => {
  const id = p.data.projeto?.id;
  const nome = id ? nomes.get(id) : undefined;
  return id && nome ? { id, nome } : undefined;
};

// Filtros em uso, sem repetir. Com uma opção só, filtrar não serve para nada.
const tags = [...new Set(pilulas.flatMap((p) => p.data.tags))];
const projetos = [
  ...new Map(
    pilulas
      .map(projetoDe)
      .filter((x): x is Projeto => x !== undefined)
      .map((x) => [x.id, x]),
  ).values(),
];
const filtroTag = tags.length >= 2;
const filtroProjeto = projetos.length >= 2;
const total = pilulas.length;
---
<Base title="Pílulas — João Victor Mendes" description="O que eu aprendi resolvendo problemas nos meus projetos, em anotações curtas.">
  <p class="eyebrow">{total === 1 ? '1 anotação' : `${total} anotações`}</p>
  <h1 class="titulo">Pílulas de<br /><span class="ital grad">conhecimento</span></h1>
  <p class="lede abertura">O que eu aprendi resolvendo algo, com a data em que escrevi.</p>

  {(filtroTag || filtroProjeto) && (
    <div class="filtros" hidden data-filtros>
      {filtroProjeto && (
        <div class="grupo" role="group" aria-label="Filtrar por projeto">
          <span class="rotulo">projeto</span>
          <button type="button" aria-pressed="true" data-chave="projeto" data-valor="">todos</button>
          {projetos.map((p) => <button type="button" aria-pressed="false" data-chave="projeto" data-valor={p.id}>{p.nome}</button>)}
        </div>
      )}
      {filtroTag && (
        <div class="grupo" role="group" aria-label="Filtrar por tema">
          <span class="rotulo">tema</span>
          <button type="button" aria-pressed="true" data-chave="tag" data-valor="">tudo</button>
          {tags.map((t) => <button type="button" aria-pressed="false" data-chave="tag" data-valor={t}>{t}</button>)}
        </div>
      )}
    </div>
  )}

  {total === 0 ? (
    <p class="vazio">Nenhuma pílula publicada ainda.</p>
  ) : (
    <>
      <ul class="lista">
        {pilulas.map((p) => {
          const projeto = projetoDe(p);
          return (
            <li data-tags={p.data.tags.join(' ')} data-projeto={projeto?.id ?? ''}>
              <a class="pcard" href={`/pilulas/${p.id}`}>
                {projeto && <span class="projeto">{projeto.nome}</span>}
                <h2>{p.data.titulo}</h2>
                <p>{p.data.resumo}</p>
                <span class="meta">
                  <em>{p.data.tags[0]}</em>
                  <time datetime={dataISO(p.data.data)}>{formatarData(p.data.data)}</time>
                  <span>{tempoDeLeitura(p.body)} min</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="vazio" hidden data-sem-resultado>Nenhuma pílula com esse filtro.</p>
    </>
  )}
</Base>

<script>
  // Filtros por projeto e por tema, combinados: escolher "AniDeck" e "go" mostra
  // só as pílulas de Go do AniDeck. Só esconde e mostra itens que já estão no
  // HTML. Sem JavaScript, os filtros nem aparecem (hidden) e a lista mostra tudo.
  const filtros = document.querySelector<HTMLElement>('[data-filtros]');
  if (filtros) {
    filtros.hidden = false;
    const escolha: Record<string, string> = { projeto: '', tag: '' };
    const botoes = filtros.querySelectorAll<HTMLButtonElement>('button');
    const itens = document.querySelectorAll<HTMLElement>('[data-tags]');
    const semResultado = document.querySelector<HTMLElement>('[data-sem-resultado]');

    botoes.forEach((botao) => {
      botao.addEventListener('click', () => {
        const chave = botao.dataset.chave ?? '';
        escolha[chave] = botao.dataset.valor ?? '';
        botoes.forEach((b) => {
          if (b.dataset.chave === chave) b.setAttribute('aria-pressed', String(b === botao));
        });

        let visiveis = 0;
        itens.forEach((item) => {
          const casaTag = escolha.tag === '' || (item.dataset.tags ?? '').split(' ').includes(escolha.tag);
          const casaProjeto = escolha.projeto === '' || item.dataset.projeto === escolha.projeto;
          item.hidden = !(casaTag && casaProjeto);
          if (!item.hidden) visiveis++;
        });
        if (semResultado) semResultado.hidden = visiveis > 0;
      });
    });
  }
</script>

<style>
  .titulo { font-size: clamp(36px, 6.4vw, 58px); }
  .abertura { margin-top: 22px; }

  .filtros { display: grid; gap: 10px; margin-top: 28px; }
  /* Sem estas linhas, o display acima venceria o atributo hidden. */
  .filtros[hidden], .vazio[hidden] { display: none; }
  .grupo { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .rotulo { font-family: var(--mono); font-size: 10.5px; color: var(--fg3); letter-spacing: .06em; min-width: 62px; }
  .grupo button { font-family: var(--mono); font-size: 11.5px; padding: 7px 15px; border-radius: 999px; border: 1px solid var(--line2); background: none; color: var(--fg2); cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .grupo button:hover { border-color: var(--fg3); color: var(--fg); }
  .grupo button[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  .lista { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 820px) { .lista { grid-template-columns: 1fr; } }
  .pcard { display: block; height: 100%; text-decoration: none; color: inherit; border: 1px solid var(--line); background: var(--card); border-radius: 18px; padding: 24px; transition: border-color .22s, background .22s, transform .22s; }
  .pcard:hover { border-color: var(--line2); background: var(--card2); }
  .pcard:focus-visible { border-radius: 18px; }
  @media (prefers-reduced-motion: no-preference) { .pcard:hover { transform: translateY(-3px); } }
  .projeto { display: block; font-family: var(--mono); font-size: 10.5px; color: var(--fg3); letter-spacing: .06em; text-transform: uppercase; margin-bottom: 10px; }
  .pcard h2 { font-size: 16.5px; line-height: 1.34; letter-spacing: -.02em; margin-bottom: 10px; }
  .pcard p { font-size: 14px; color: var(--fg2); margin: 0 0 18px; line-height: 1.55; }
  .meta { display: flex; gap: 10px; align-items: center; font-family: var(--mono); font-size: 10.5px; color: var(--fg3); }
  .meta em { font-style: normal; color: var(--acc); background: var(--acc-dim); padding: 3px 9px; border-radius: 6px; }
  .vazio { margin-top: 32px; font-family: var(--mono); font-size: 12px; color: var(--fg3); }
</style>