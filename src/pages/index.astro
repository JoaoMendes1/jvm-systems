---
// Home: hero, quadro "rodando agora", projetos, competências e contato.
// Tudo que é projeto ou contagem vem das coleções, pelas regras de
// src/lib/conteudo.ts. Nada sobre os projetos é escrito à mão aqui.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import { temCard, estaNoAr, temEstudoDeCaso, porOrdem, pilulaPublicada } from '../lib/conteudo';
import { COMPETENCIAS, type Prova } from '../data/competencias';

const projetos = await getCollection('projetos');
const pilulas = await getCollection('pilulas');

const cards = projetos.filter(temCard).sort(porOrdem);
const noAr = cards.filter(estaNoAr);
const totalEstudos = cards.filter(temEstudoDeCaso).length;
const pilulasVisiveis = pilulas.filter(pilulaPublicada);
const totalPilulas = pilulasVisiveis.length;
// Tags do card de pílulas: só as que estão em uso, sem repetir.
const tagsEmUso = [...new Set(pilulasVisiveis.flatMap((p) => p.data.tags))];

// Stat com valor zero não aparece: "0 pílulas" parece site quebrado.
const stats = [
  { n: noAr.length, um: 'serviço no ar', varios: 'serviços no ar' },
  { n: totalEstudos, um: 'estudo de caso', varios: 'estudos de caso' },
  { n: totalPilulas, um: 'pílula publicada', varios: 'pílulas publicadas' },
]
  .filter((s) => s.n > 0)
  .map((s) => ({ valor: String(s.n), rotulo: s.n === 1 ? s.um : s.varios }));

// Prova de competência: projeto vira link para o estudo de caso, ou para o
// repositório quando ainda não há estudo. Projeto sem card não prova nada,
// e a prova some; competência sem nenhuma prova some junto.
type Link = { rotulo: string; href: string; externo: boolean };
const porId = new Map(cards.map((p) => [p.id, p]));
const resolver = (prova: Prova): Link | undefined => {
  if ('projeto' in prova) {
    const p = porId.get(prova.projeto);
    if (!p || !p.data.repo) return undefined;
    return temEstudoDeCaso(p)
      ? { rotulo: p.data.nome, href: `/projetos/${p.id}`, externo: false }
      : { rotulo: p.data.nome, href: p.data.repo, externo: true };
  }
  return { ...prova, externo: true };
};
const competencias = COMPETENCIAS.map((g) => ({
  area: g.area,
  itens: g.itens
    .map((i) => ({ texto: i.texto, provas: i.provas.map(resolver).filter((l): l is Link => Boolean(l)) }))
    .filter((i) => i.provas.length > 0),
})).filter((g) => g.itens.length > 0);

// "https://anideck.joaomendes.dev.br" vira "anideck.joaomendes.dev.br".
const dominio = (url?: string) => (url ? new URL(url).host : '');
---
<Base
  title="João Victor Mendes"
  description="Portfólio de João Victor Mendes: projetos em produção, com código aberto no GitHub e as decisões técnicas de cada um."
>
  <section class="hero">
    <p class="eyebrow an">Desenvolvedor full-stack júnior · São José, SC</p>
    <h1 class="an">Construo software<br /><span class="ital grad">e coloco no ar.</span></h1>
    <p class="lede an">
      Desenvolvo em Go e React, com PostgreSQL. Meus projetos rodam numa VPS Linux que configurei
      do zero: Docker, Caddy, HTTPS automático e deploy a cada push. O código e as decisões de cada
      um estão abertos no GitHub.
    </p>
    <div class="actions an">
      <a class="btn p" href="#projetos">Ver projetos</a>
      <a class="btn s" href="/sobre">Sobre mim</a>
    </div>
    <div class="stats an">
      {stats.map((s) => (
        <div><b>{s.valor}</b><span>{s.rotulo}</span></div>
      ))}
    </div>
  </section>

  {noAr.length > 0 && (
    <section class="bloco">
      <p class="eyebrow">rodando agora</p>
      <h2>O que está no ar</h2>
      <div class="board">
        <div class="board-top"><span>vps própria · docker · caddy</span><span>gerado no build</span></div>
        {noAr.map((p) => (
          <div class="svc">
            <b>{p.id}</b>
            <span class="stk">{p.data.stack.slice(0, 3).join(' · ')}</span>
            <a class="dom" href={p.data.url} target="_blank" rel="noopener noreferrer">{dominio(p.data.url)}</a>
            <span class="tag"><i class="dot"></i>no ar</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {cards.length > 0 && (
    <section class="bloco" id="projetos">
      <p class="eyebrow">código aberto</p>
      <h2>Projetos</h2>
      <p class="lede">O código de cada um está no GitHub.</p>
      <div class="grid">
        {cards.map((p) => (
          <article class="card">
            {/* Com capa, a captura de tela aparece como uma janela sobre o
                gradiente. Sem capa, fica só o gradiente, que é decoração. */}
            <div class:list={['cap', p.data.visual, { 'com-tela': p.data.capa }]} aria-hidden={p.data.capa ? undefined : 'true'}>
              {p.data.capa && (
                <img src={p.data.capa} alt={p.data.capaAlt} width="1200" height="800" loading="lazy" decoding="async" />
              )}
            </div>
            <div class="corpo">
              <div class="nome">
                <h3>{p.data.nome}</h3>
                {p.data.fase && <span class="fase">{p.data.fase}</span>}
              </div>
              <p>{p.data.resumo}</p>
              <ul class="chips">
                {p.data.stack.map((s, i) => <li class:list={['chip', { principal: i === 0 }]}>{s}</li>)}
              </ul>
              {/* Estudo de caso é página do site: mesma guia. Repositório é externo: nova guia. */}
              {temEstudoDeCaso(p)
                ? <a class="more" href={`/projetos/${p.id}`}>Ler o estudo de caso <span aria-hidden="true">→</span></a>
                : <a class="more" href={p.data.repo} target="_blank" rel="noopener noreferrer">Ver o código <span aria-hidden="true">→</span></a>}
            </div>
          </article>
        ))}
        {totalPilulas > 0 && (
          <article class="card">
            <div class="cap neutro" aria-hidden="true"></div>
            <div class="corpo">
              <h3>Pílulas de conhecimento</h3>
              <p>Anotações curtas do que aprendi resolvendo problemas nos projetos.</p>
              <ul class="chips">
                {tagsEmUso.map((t) => <li class="chip">{t}</li>)}
              </ul>
              <a class="more" href="/pilulas">Ver as pílulas <span aria-hidden="true">→</span></a>
            </div>
          </article>
        )}
      </div>
    </section>
  )}

  {competencias.length > 0 && (
    <section class="bloco" id="competencias">
      <p class="eyebrow">o que eu sei fazer</p>
      <h2>Competências, com prova</h2>
      <p class="lede">Cada item aponta para o projeto onde ele está no código.</p>
      <div class="comp">
        {competencias.map((g) => (
          <div class="comp-grupo">
            <h3>{g.area}</h3>
            <ul>
              {g.itens.map((i) => (
                <li>
                  <span>{i.texto}</span>
                  <span class="provas">
                    {i.provas.map((l) => (
                      l.externo
                        ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.rotulo}</a>
                        : <a href={l.href}>{l.rotulo}</a>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <Contato />
</Base>

<style>
  /* ── hero ── */
  .hero h1 { font-size: clamp(44px, 8.4vw, 92px); }
  .hero h1 .ital { font-size: 1.06em; }
  .hero .lede { margin-top: 28px; }
  .hero .actions { margin-top: 34px; }

  /* Entrada em cascata. Sem permissão de movimento, tudo já nasce visível. */
  @media (prefers-reduced-motion: no-preference) {
    .an { opacity: 0; animation: subir .8s cubic-bezier(.2, .7, .3, 1) forwards; }
    .an:nth-child(2) { animation-delay: .1s; }
    .an:nth-child(3) { animation-delay: .2s; }
    .an:nth-child(4) { animation-delay: .3s; }
    .an:nth-child(5) { animation-delay: .4s; }
    @keyframes subir { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; margin-top: 58px; }
  .stats div { background: var(--bg2); padding: 22px 24px; }
  .stats b { display: block; font-family: var(--disp); font-size: 32px; font-weight: 600; letter-spacing: -.04em; line-height: 1.1; }
  .stats span { font-size: 13px; color: var(--fg3); }

  .bloco { padding-top: 60px; scroll-margin-top: 24px; }

  /* ── rodando agora ── */
  .board { border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(180deg, var(--card), var(--bg2)); overflow: hidden; margin-top: 22px; box-shadow: 0 20px 60px rgba(0, 0, 0, .35); }
  .board-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; padding: 15px 22px; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 12px; color: var(--fg3); }
  .svc { display: grid; grid-template-columns: 150px 1fr 1fr auto; gap: 16px; align-items: center; padding: 16px 22px; border-bottom: 1px solid var(--line); font-size: 14px; }
  .svc:last-child { border-bottom: 0; }
  .svc b { font-family: var(--mono); font-size: 13px; font-weight: 500; }
  .stk { color: var(--fg2); font-size: 13.5px; }
  .dom { font-family: var(--mono); font-size: 11.5px; color: var(--fg3); text-decoration: none; }
  .dom:hover { color: var(--acc); }
  .tag { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; padding: 4px 11px; border-radius: 999px; background: color-mix(in srgb, var(--live) 10%, transparent); color: var(--live); justify-self: end; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  @media (prefers-reduced-motion: no-preference) {
    .dot { animation: pulso 2.4s ease-out infinite; }
    @keyframes pulso { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--live) 50%, transparent); } 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
  }
  @media (max-width: 780px) {
    .svc { grid-template-columns: 1fr auto; gap: 3px 12px; }
    .stk, .dom { grid-column: 1; font-size: 12px; }
    .tag { grid-row: 1; grid-column: 2; }
  }

  /* ── projetos ── */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 24px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
  .card { border: 1px solid var(--line); background: var(--card); border-radius: 20px; overflow: hidden; transition: transform .26s cubic-bezier(.2, .7, .3, 1), border-color .26s, box-shadow .26s; }
  .card:hover { border-color: var(--line2); box-shadow: 0 24px 60px rgba(0, 0, 0, .45); }

  /* Capa: gradiente escolhido pelo campo `visual`, com grade que se apaga. */
  .cap { height: 142px; position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .cap::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(150% 95% at 18% 0%, #000, transparent 70%);
  }
  .cap.laranja { background: linear-gradient(135deg, #301C10, #41230F 52%, #120F0D); }
  .cap.verde { background: linear-gradient(135deg, #0F211B, #12332A 52%, #0C1211); }
  .cap.violeta { background: linear-gradient(135deg, #191627, #26213E 52%, #101017); }
  .cap.neutro { background: linear-gradient(135deg, #1B1B21, #27272F 52%, #0F0F13); }

  /* Captura de tela como uma janela que sai de baixo do card. */
  .cap.com-tela { height: 210px; }
  .cap img {
    position: absolute;
    left: 7%;
    top: 26px;
    width: 86%;
    height: calc(100% - 26px);
    object-fit: cover;
    object-position: top left;
    border-radius: 10px 10px 0 0;
    border: 1px solid rgba(255, 255, 255, .12);
    border-bottom: 0;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, .5);
    transition: transform .4s cubic-bezier(.2, .7, .3, 1);
  }

  .corpo { padding: 22px 24px 24px; }
  .corpo p { font-size: 14.5px; color: var(--fg2); margin: 10px 0 17px; line-height: 1.56; }
  .nome { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .fase { font-family: var(--mono); font-size: 10.5px; padding: 3px 10px; border-radius: 999px; background: var(--acc-dim); color: var(--acc); white-space: nowrap; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .chip { font-family: var(--mono); font-size: 10.5px; padding: 4px 9px; border-radius: 7px; border: 1px solid var(--line2); color: var(--fg2); }
  .chip.principal { background: var(--acc-dim); border-color: transparent; color: var(--acc); }
  .more { display: inline-flex; gap: 8px; margin-top: 19px; font-size: 13.5px; font-weight: 500; color: var(--acc); text-decoration: none; }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover { transform: translateY(-4px); }
    .card:hover .cap img { transform: translateY(-6px); }
    .more span { transition: transform .25s; }
    .card:hover .more span { transform: translateX(5px); }
  }

  /* ── competências ── */
  .comp { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 24px; }
  @media (max-width: 820px) { .comp { grid-template-columns: 1fr; } }
  .comp-grupo { border: 1px solid var(--line); background: var(--card); border-radius: 18px; padding: 22px 24px; }
  .comp-grupo h3 { font-size: 16px; margin-bottom: 14px; }
  .comp-grupo ul { list-style: none; margin: 0; padding: 0; }
  .comp-grupo li { display: flex; flex-direction: column; gap: 5px; padding: 11px 0; border-top: 1px solid var(--line); font-size: 14px; color: var(--fg2); line-height: 1.5; }
  .comp-grupo li:first-child { border-top: 0; padding-top: 0; }
  .provas { display: flex; flex-wrap: wrap; gap: 12px; font-family: var(--mono); font-size: 11px; }
  .provas a { color: var(--acc); text-decoration: none; }
  .provas a:hover { text-decoration: underline; }
</style>